# Local backend: use the MongoDB server listening on localhost:27017.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE_NAME=aquawatch_db

# Docker Compose only: replace both placeholders with unique local values first.
DB_PASSWORD=replace-with-a-unique-local-password
JWT_SECRET=replace-with-a-unique-local-secret

# Comma-separated browser origins permitted to call the backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend: Vite embeds this public API base URL in the built JavaScript.
VITE_API_BASE_URL=http://localhost:8000
